---
// Latar website: jejak sirkuit dengan pulsa cahaya + aurora tipis
// Jalur sirkuit dibuat otomatis saat build (acak tapi selalu sama setiap build)
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const pick = <T,>(arr: T[]) => arr[Math.floor(rnd() * arr.length)];

const W = 1600, H = 1000, STEP = 40;
// Jalur netral (abu-abu), warna hanya untuk pulsa cahaya
const ACCENTS = ["#22d3ee", "#22d3ee", "#22d3ee", "#a78bfa"]; // dominan cyan, sesekali ungu

type Trace = { d: string; end: [number, number]; color: string; pulse: boolean; dur: number; delay: number };
const traces: Trace[] = [];
for (let i = 0; i < 34; i++) {
  let x = Math.round((rnd() * W) / STEP) * STEP;
  let y = Math.round((rnd() * H) / STEP) * STEP;
  let d = `M${x} ${y}`;
  let horizontal = rnd() > 0.5;
  const segments = 2 + Math.floor(rnd() * 4);
  for (let s = 0; s < segments; s++) {
    const len = (2 + Math.floor(rnd() * 6)) * STEP;
    const dir = rnd() > 0.5 ? 1 : -1;
    // Belokan 45° kecil supaya terlihat seperti jalur PCB asli
    if (rnd() > 0.6) {
      const k = STEP * (1 + Math.floor(rnd() * 2));
      x += horizontal ? dir * k : k * (rnd() > 0.5 ? 1 : -1);
      y += horizontal ? k * (rnd() > 0.5 ? 1 : -1) : dir * k;
      d += ` L${x} ${y}`;
    }
    if (horizontal) x += dir * len;
    else y += dir * len;
    d += ` L${x} ${y}`;
    horizontal = !horizontal;
  }
  traces.push({
    d,
    end: [x, y],
    color: pick(ACCENTS),
    pulse: i % 2 === 0, // separuh jalur punya pulsa cahaya
    dur: 4 + rnd() * 6,
    delay: -rnd() * 8,
  });
}
// Titik-titik "chip" kecil
const pads = Array.from({ length: 26 }, () => ({
  x: Math.round((rnd() * W) / STEP) * STEP,
  y: Math.round((rnd() * H) / STEP) * STEP,
  s: pick([6, 8, 10]),
}));
---

<div class="backdrop pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <!-- Aurora tipis -->
  <div class="aurora aurora-1"></div>
  <div class="aurora aurora-2"></div>

  <!-- Sirkuit -->
  <svg class="circuit absolute inset-0 h-full w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <!-- Jalur dasar (samar) -->
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      {traces.map((t) => <path d={t.d} stroke="#94a3b8" stroke-opacity="0.07" stroke-width="2" />)}
    </g>

    <!-- Ujung jalur & pad -->
    {traces.map((t) => (
      <circle cx={t.end[0]} cy={t.end[1]} r="4" fill="#05060a" stroke="#94a3b8" stroke-opacity="0.18" stroke-width="1.5" />
    ))}
    {pads.map((p) => (
      <rect x={p.x - p.s / 2} y={p.y - p.s / 2} width={p.s} height={p.s} rx="2" fill="#94a3b8" fill-opacity="0.08" />
    ))}

    <!-- Pulsa cahaya yang berjalan di sepanjang jalur -->
    <g fill="none" stroke-linecap="round" filter="url(#glow)">
      {traces.filter((t) => t.pulse).map((t) => (
        <path
          class="pulse"
          d={t.d}
          stroke={t.color}
          stroke-width="2"
          pathLength="100"
          style={`animation-duration:${t.dur.toFixed(2)}s;animation-delay:${t.delay.toFixed(2)}s`}
        />
      ))}
    </g>
  </svg>

  <!-- Vinyet: tengah lebih gelap supaya teks tetap mudah dibaca -->
  <div class="vignette absolute inset-0"></div>
</div>

<style>
  .backdrop { background: #05060a; }

  /* ===== Aurora ===== */
  .aurora {
    position: absolute;
    border-radius: 9999px;
    filter: blur(110px);
    opacity: 0.12;
    will-change: transform;
  }
  .aurora-1 { width: 45vw; height: 45vw; left: -18vw; top: -22vw; background: #22d3ee; animation: drift1 30s ease-in-out infinite alternate; }
  .aurora-2 { width: 40vw; height: 40vw; right: -16vw; bottom: -18vw; background: #7c3aed; animation: drift2 36s ease-in-out infinite alternate; }
  @keyframes drift1 { to { transform: translate(12vw, 10vh) scale(1.1); } }
  @keyframes drift2 { to { transform: translate(-12vw, -10vh) scale(0.95); } }

  /* ===== Sirkuit ===== */
  .circuit {
    /* sirkuit memudar ke arah tengah layar */
    mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 20%, #000 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 20%, #000 75%);
  }
  .pulse {
    stroke-dasharray: 8 92; /* garis cahaya pendek sepanjang 8% jalur */
    animation-name: run;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes run { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  .vignette { background: radial-gradient(ellipse at center, transparent 45%, rgb(0 0 0 / 0.55) 100%); }

  @media (prefers-reduced-motion: reduce) {
    .aurora, .pulse { animation: none; }
    .pulse { opacity: 0; }
  }
</style>