---
// Menampilkan logo teknologi dari Simple Icons (ditanam saat build, tanpa beban di browser)
import * as si from "simple-icons";

interface Props {
  icon?: string;
  initials?: string;
  color?: string;
  size?: number;
}
const { icon, initials, color, size = 28 } = Astro.props;

const key = icon ? "si" + icon[0].toUpperCase() + icon.slice(1) : "";
const data = (si as Record<string, { path: string; hex: string; title: string } | undefined>)[key];
const hex = data ? `#${data.hex}` : color ?? "#94a3b8";

// Logo berwarna gelap (mis. GitHub, Vercel) dibuat terang supaya terlihat di latar gelap
const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
const dark = 0.299 * r + 0.587 * g + 0.114 * b < 70;
const fill = dark ? "#e2e8f0" : hex;
---

<span class="grid shrink-0 place-items-center rounded-xl" style={`width:${size + 20}px;height:${size + 20}px;background:${fill}1f;box-shadow:inset 0 0 0 1px ${fill}40`}>
  {data ? (
    <svg role="img" viewBox="0 0 24 24" width={size} height={size} fill={fill} aria-label={data.title}><path d={data.path} /></svg>
  ) : (
    <span class="font-bold" style={`color:${fill};font-size:${size * 0.55}px`}>{initials ?? "?"}</span>
  )}
</span>
